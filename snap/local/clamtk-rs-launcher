#!/bin/sh
set -eu

# SNAP_ARCH_TRIPLET is only provided by the GNOME extension, so compute it
# from the system architecture when it is not set.
if [ -n "${SNAP_ARCH_TRIPLET:-}" ]; then
    triplet="$SNAP_ARCH_TRIPLET"
else
    case "$(uname -m)" in
        x86_64) triplet="x86_64-linux-gnu" ;;
        aarch64) triplet="aarch64-linux-gnu" ;;
        armv7l|armhf) triplet="arm-linux-gnueabihf" ;;
        i686|i386) triplet="i386-linux-gnu" ;;
        powerpc64le|ppc64el) triplet="powerpc64le-linux-gnu" ;;
        s390x) triplet="s390x-linux-gnu" ;;
        riscv64) triplet="riscv64-linux-gnu" ;;
        *)
            echo "clamtk-rs: unsupported architecture $(uname -m)" >&2
            exit 1
            ;;
    esac
fi

# The bundled ClamAV (clamscan, freshclam) lives under $SNAP/usr.
export PATH="$SNAP/usr/bin${PATH:+:$PATH}"

# The GNOME extension (via SNAP_DESKTOP_RUNTIME) already sets LD_LIBRARY_PATH
# for the GTK/GLib stack; add the bundled ClamAV libraries from $SNAP/usr.
export LD_LIBRARY_PATH="$SNAP/usr/lib/$triplet${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# GTK provided by the gnome-platform content snap is newer than the host's, so
# host themes written for newer GTK (e.g. Yaru's "rgb(from ...)" syntax) cannot
# be parsed. Use the built-in Adwaita theme and the cairo renderer instead.
gsettings_bin="${SNAP_DESKTOP_RUNTIME:+$SNAP_DESKTOP_RUNTIME/usr/bin/}gsettings"
if [ ! -x "$gsettings_bin" ]; then
    gsettings_bin="gsettings"
fi
case "$("$gsettings_bin" get org.gnome.desktop.interface color-scheme 2>/dev/null || echo '')" in
    *prefer-dark*|*dark*)
        export GTK_THEME="Adwaita:dark"
        ;;
    *)
        export GTK_THEME="Adwaita"
        ;;
esac
export GSK_RENDERER=cairo

exec "$SNAP/bin/clamtk-rs" "$@"
