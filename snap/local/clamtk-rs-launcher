#!/bin/sh
set -eu

# SNAP_ARCH_TRIPLET is only provided by the GNOME extension, so compute it
# from the system architecture when it is not set.
if [ -n "${SNAP_ARCH_TRIPLET:-}" ]; then
    triplet="$SNAP_ARCH_TRIPLET"
else
    case "$(uname -m)" in
        x86_64) triplet="x86_64-linux-gnu" ;;
        aarch64) triplet="aarch64-linux-gnu" ;;
        armv7l|armhf) triplet="arm-linux-gnueabihf" ;;
        i686|i386) triplet="i386-linux-gnu" ;;
        powerpc64le|ppc64el) triplet="powerpc64le-linux-gnu" ;;
        s390x) triplet="s390x-linux-gnu" ;;
        riscv64) triplet="riscv64-linux-gnu" ;;
        *)
            echo "clamtk-rs: unsupported architecture $(uname -m)" >&2
            exit 1
            ;;
    esac
fi

# Bundled GTK4/GLib runtime libraries. Binaries are patched at build time to
# use the core24 dynamic loader and rpaths, so LD_LIBRARY_PATH only needs to
# cover dlopen'd modules (gdk-pixbuf loaders, gio modules) not reachable via
# rpath.
export LD_LIBRARY_PATH="$SNAP/usr/lib/$triplet"
export XDG_DATA_DIRS="$SNAP/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# GIO's compiled-in module directory (/usr/lib/x86_64-linux-gnu/gio/modules)
# is the HOST's on a classic snap. Its gvfs modules were built against a newer
# GLib than core24's, so loading them fails with
# "undefined symbol: g_variant_builder_init_static". Point GIO at the modules
# bundled with the snap instead.
export GIO_MODULE_DIR="$SNAP/usr/lib/$triplet/gio/modules"

# The bundled GTK 4.14 cannot parse host themes written for newer GTK (e.g.
# Yaru's "rgb(from ...)" syntax), and its GL/Vulkan stack cannot use the host
# GPU drivers. Use the built-in Adwaita theme and the cairo renderer instead.
case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo '')" in
    *prefer-dark*|*dark*)
        export GTK_THEME="Adwaita:dark"
        ;;
    *)
        export GTK_THEME="Adwaita"
        ;;
esac
export GSK_RENDERER=cairo

exec "$SNAP/bin/clamtk-rs" "$@"
